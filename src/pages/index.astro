---
export const prerender = false;

import ActivityDisplay from "~/components/ActivityDisplay.astro";
import BadgeDisplay from "~/components/BadgeDisplay.astro";
import Card from "~/components/Card.astro";
import Carousel from "~/components/Carousel.astro";
import Grid from "~/components/Grid.astro";
import ListenDisplay from "~/components/ListenDisplay.astro";
import ProjectCard from "~/components/ProjectCard.astro";
import { BADGES, FRIEND_AVATARS, FRIEND_BADGES, MISC_PROJECTS, PROJECTS } from "~/constants";
import Layout from "~/layouts/Layout.astro";
import type { Activity, Listen } from "~/types";

import { GET as getActivities } from "./api/activities.json";
import { GET as getListens } from "./api/listens.json";

const activitiesResponse = await getActivities();
const activities: Activity[] = await activitiesResponse.json();

const listensResponse = await getListens();
const listens: Listen[] = await listensResponse.json();
---

<Layout
	title="hi, i'm <mark>caitlyn!</mark>"
	subtitle="20 years old, Australia"
>
	<sub>
		A woman who can't program but can do some other stuff decently well. You
		can find me around the web.
	</sub>
	<hr />

	<h3>Library Updates</h3>
	<Carousel>
		{activities.map(activity => <ActivityDisplay activity={activity} />)}
		<sub slot="carousel-label">
			You can find more on my
			{" "}
			<a class="link" href="https://anilist.co/user/aussieauntie/">AniList</a>
			{" & "}
			<a class="link" href="https://hardcover.app/@_alice">Hardcover</a>
		</sub>
	</Carousel>

	<h3>Recent Tracks</h3>
	<Carousel>
		{listens.map(listen => <ListenDisplay listen={listen} />)}
		<sub slot="carousel-label">
			You can find more on my
			{" "}
			<a class="link" href="https://listenbrainz.org/user/caitlyn/">ListenBrainz</a>
		</sub>
	</Carousel>

	<h3>Projects</h3>
	<Grid>
		{PROJECTS.map(project => <ProjectCard {project} />)}
	</Grid>

	<h3>Miscellaneous Creations</h3>
	<Grid>
		{MISC_PROJECTS.map(project => <ProjectCard {project} />)}
		<ProjectCard project={undefined} />
	</Grid>

	<h3>Cute Entities</h3>
	<sub>
		You can add my <a class="link" href="/88x31.png">88x31</a> if we are close :)
	</sub>

	<Card class="badge-grid" elevation={null}>
		{BADGES.map(badge => <BadgeDisplay {badge} />)}
	</Card>

	<Card class="badge-grid" elevation={null}>
		{FRIEND_BADGES.map((badge) => {
			if (badge === "fish") {
				return (
					<iframe
						width="88"
						height="31"
						style="border:none"
						title="rini"
						sandbox="allow-scripts allow-popups"
						src="https://paige.moe/fish.html"
					/>
				);
			} else {
				return <BadgeDisplay {badge} />;
			}
		})}
	</Card>

	<Card id="friends-grid" elevation={null}>
		{FRIEND_AVATARS.map(badge => <BadgeDisplay {badge} width={50} height={50} round />)}
	</Card>
</Layout>

<script>
const friends = document.getElementById("friends-grid")!;

for (let i = friends.children.length; i > 1; i--) {
	friends.appendChild(friends.children[(Math.random() * (i - 0)) | 0]);
}
</script>

<style>
.badge-grid {
	display: grid;
	place-items: center;
	grid-template-columns: repeat(auto-fill, minmax(88px, 1fr));
	gap: 0.5rem;
	padding: 0.5em;
	image-rendering: pixelated;
	margin-top: 1rem;
	margin-top: 0.5rem;
	margin-bottom: 0.5rem;
}

#friends-grid {
	display: grid;
	place-items: center;
	gap: 0.5rem;
	grid-template-columns: repeat(auto-fill, minmax(50px, 1fr));
	padding: 0.5em;
	margin-top: 0.5rem;
	margin-bottom: 0.5rem;
}
</style>
