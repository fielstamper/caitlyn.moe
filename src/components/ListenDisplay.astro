---
import type { Listen } from "~/types";
import { truncateString } from "~/utils";

import CarouselItem from "./CarouselItem.astro";

interface Props {
	listen: Listen;
}

const { listen } = Astro.props as Props;
---

<CarouselItem
	href={`https://listenbrainz.org/track/${listen.track_metadata.additional_info.recording_mbid}`}
	target="_blank"
	rel="nofollow"
>
	<img
		class="cover"
		src={`https://coverartarchive.org/release-group/${listen.track_metadata.additional_info.release_group_mbid}/front-250`}
	/>
	<p>{truncateString(listen.track_metadata.track_name, 27)}</p>
	<sub>{truncateString(listen.track_metadata.artist_name, 15)}</sub>
</CarouselItem>
<style>
	@media (max-width: 600px) {
		.cover {
			width: calc(7.813rem * 0.9) !important;
			height: calc(7.813rem * 0.9) !important;
		}
	}
</style>
