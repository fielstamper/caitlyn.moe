---
import type { HTMLTag, Polymorphic } from "astro/types";

type Props<Tag extends HTMLTag = HTMLTag> = Polymorphic<{
	as: Tag;
	disabled?: boolean;
	variant?: "filled" | "bordered" | "accented";
	elevation?: "low" | null;
}>;

const {
	as: Tag = "div",
	disabled = false,
	variant = "filled",
	elevation = variant == "filled" ? "low" : undefined,
	class: className,
	...props
} = Astro.props;
---

<Tag
	class:list={[
		"card",
		variant,
		elevation && `elevation-${elevation}`,
		disabled && "disabled",
		className,
	]}
	{...props}
>
	<slot />
</Tag>

<style>
.card {
	--border-color: transparent;
	--background-color: transparent;
	border: 1px solid var(--border-color);
	background-color: var(--background-color);
	border-radius: 8px;
	padding: 0.7em;
	transition: all 0.25s cubic-bezier(0.17, 0.85, 0.29, 0.95);
	color: var(--text-secondary);
	overflow: hidden;
	font-family: inherit;
	display: flex;
}
.card.filled, .card.bordered {
	--border-color: var(--grey-3);
}
.card.filled {
	--background-color: var(--grey-2);
}
.card.accented {
	--border-color: light-dark(var(--accent-secondary), var(--grey-3));
	--background-color: light-dark(var(--accent), var(--grey-2));
	color: light-dark(black, var(--text-secondary));
}
a.card:not(.disabled):focus-visible, button.card:not(.disabled):focus-visible,
a.card:not(.disabled):hover, button.card:not(.disabled):hover {
	cursor: pointer;
	background-color: var(--border-color);
}

a.card, a.button {
	user-select: none;
	padding: 0.5em 0.8em;
}
a.card:not(.disabled):active, button.card:not(.disabled):active {
	scale: 0.95;
	border-radius: 6px;
}

.card.disabled {
	opacity: 0.5;
}

.card.elevation-low {
	box-shadow: var(--shadow-low);
}
</style>
