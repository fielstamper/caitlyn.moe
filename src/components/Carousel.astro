---
import type { HTMLAttributes } from "astro/types";

import Card from "./card.astro";

const { class: bodyClassName, ...bodyProps } = Astro.props as HTMLAttributes<"div">;
---

<div class="carousel-container">
	<div {...bodyProps} class:list={["carousel-body", bodyClassName]}>
		<slot />
	</div>
	<div class="carousel-buttons">
		<div class="carousel-label"><slot name="carousel-label" /></div>
		<Card hoverable className="carousel-prev">&lt;</Card>
		<Card hoverable className="carousel-next">&gt;</Card>
	</div>
</div>
<script>
const scrollDuration = 250;

function animateScrollLeft(
	element: Element,
	scrollPx: number,
	// cubic i think idk
	easing = (t: number) => 1 - Math.pow(1 - t, 3),
) {
	const startScrollLeft = element.scrollLeft;
	const distance = scrollPx - startScrollLeft;
	let startTime: number | null = null;

	function frame(currentTime: number) {
		if (!startTime) startTime = currentTime;

		const elapsed = currentTime - startTime;
		const progress = Math.min(elapsed / scrollDuration, 1);
		const easedProgress = easing(progress);
		element.scrollLeft = startScrollLeft + distance * easedProgress;

		if (progress < 1) requestAnimationFrame(frame);
	}

	requestAnimationFrame(frame);
}

document.addEventListener("astro:page-load", () => {
	document.querySelectorAll(".carousel-container").forEach((container) => {
		const body = container.querySelector(".carousel-body")!;
		const prevButton = container.querySelector(".carousel-prev")!;
		const nextButton = container.querySelector(".carousel-next")!;
		let lastClick = Date.now();

		function handleCarouselMove(direction: number) {
			if ((Date.now() - lastClick) < scrollDuration) return;
			const slideWidth = body.firstElementChild!.clientWidth * 4;
			const scrollPx = body.scrollLeft + slideWidth * direction;
			animateScrollLeft(body, scrollPx);
			lastClick = Date.now();
		}

		prevButton.addEventListener("click", () => handleCarouselMove(-1));
		nextButton.addEventListener("click", () => handleCarouselMove(1));
	});
});
</script>
<style>
	.carousel-container {
		display: flex;
		flex-direction: column;
	}

	.carousel-body {
		display: flex;
		justify-content: space-between;
		text-align: center;
		overflow-x: hidden;
	}

	.carousel-buttons {
		display: flex;
		align-items: center;
		justify-content: flex-end;
		height: 2rem !important;
		gap: 4px;
	}

	.carousel-prev, .carousel-next {
		cursor: pointer;
		user-select: none;
		width: 2rem !important;
		height: 2rem !important;
		padding: 0 !important;
		text-align: center;
		display: flex;
		justify-content: center;
		align-items: center;
	}

	.carousel-label {
		flex: 1;
	}
</style>
