---
import type { HTMLAttributes } from "astro/types";

import Card from "./Card.astro";

const { class: bodyClassName, ...bodyProps } = Astro.props as HTMLAttributes<"div">;
---

<div class="carousel-container">
	<div {...bodyProps} class:list={["carousel-body", bodyClassName]}>
		<slot />
	</div>
	<div class="carousel-buttons">
		<div class="carousel-label"><slot name="carousel-label" /></div>
		<Card as="button" class="carousel-prev">&lt;</Card>
		<Card as="button" class="carousel-next">&gt;</Card>
	</div>
</div>
<script>
document.addEventListener("astro:page-load", () => {
	document.querySelectorAll(".carousel-container").forEach((container) => {
		const body = container.querySelector(".carousel-body")!;
		const prevButton = container.querySelector(".carousel-prev")!;
		const nextButton = container.querySelector(".carousel-next")!;

		function handleCarouselMove(direction: number) {
			const itemWidth = body.firstElementChild!.clientWidth;
			const delta = Math.min(itemWidth * 4, body.clientWidth) * direction;

			body.scrollLeft += delta - body.scrollLeft % itemWidth;
		}

		prevButton.addEventListener("click", () => handleCarouselMove(-1));
		nextButton.addEventListener("click", () => handleCarouselMove(+1));
	});
});
</script>
<style>
	.carousel-container {
		display: flex;
		flex-direction: column;
	}

	.carousel-body {
		display: flex;
		justify-content: space-between;
		text-align: center;
		overflow-x: hidden;
		scroll-behavior: smooth;
	}

	.carousel-buttons {
		display: flex;
		align-items: center;
		justify-content: flex-end;
		height: 2rem !important;
		gap: 4px;
		padding-top: 1em;
	}

	.carousel-prev, .carousel-next {
		cursor: pointer;
		user-select: none;
		width: 2rem !important;
		height: 2rem !important;
		padding: 0 !important;
		text-align: center;
		display: flex;
		justify-content: center;
		align-items: center;
	}

	.carousel-label {
		flex: 1;
	}
</style>
